<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      kernel-core: the Forge Kernel runtime.

      The append engine, the six operations, the storage ports, and the in-memory backend. Depends
      ONLY on kernel-api (and JUnit for tests). No Spring, no JDBC, no framework: a fully functioning
      kernel that runs entirely in memory and could be released as a standalone open-source library.

      Implements: MANIFESTO Articles I, IV, V, VI; ADR-V2-0001, 0005, 0006, 0007, 0008.
      Justified by: docs/v2/KERNEL_IMPLEMENTATION_PLAN.md and the KERNEL RUNTIME roadmap revision.
    -->

    <parent>
        <groupId>com.broksforge.kernel</groupId>
        <artifactId>broks-forge-kernel</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kernel-core</artifactId>
    <packaging>jar</packaging>

    <name>Brok's Forge Kernel :: Core Runtime</name>
    <description>Append engine, six operations, storage ports, and the in-memory backend.</description>

    <dependencies>
        <dependency>
            <groupId>com.broksforge.kernel</groupId>
            <artifactId>kernel-api</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
